{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eventstorm.schema.json",
  "title": "eventstorm.yaml",
  "description": "Canonical model of one Event Storming workspace. Structural contract only: semantic rules live in references/socratic-protocol.md. verify.py validates with a built-in subset of draft 2020-12 and rejects any keyword it does not implement.",
  "type": "object",
  "required": ["schema_version", "domain", "speakers", "session"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "description": "3.1 only adds optional fields to 3.0: a 3.0 file is valid as is.", "enum": ["3.0", "3.1"] },
    "domain": { "$ref": "#/$defs/domain" },
    "speakers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/speaker" } },
    "session": { "$ref": "#/$defs/session" },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
    "actors": { "type": "array", "items": { "$ref": "#/$defs/actor" } },
    "policies": { "type": "array", "items": { "$ref": "#/$defs/policy" } },
    "read_models": { "type": "array", "items": { "$ref": "#/$defs/read_model" } },
    "external_systems": { "type": "array", "items": { "$ref": "#/$defs/external_system" } },
    "aggregates": { "type": "array", "items": { "$ref": "#/$defs/aggregate" } },
    "hotspots": { "type": "array", "items": { "$ref": "#/$defs/hotspot" } },
    "opportunities": { "type": "array", "items": { "$ref": "#/$defs/opportunity" } },
    "bounded_contexts": { "type": "array", "items": { "$ref": "#/$defs/bounded_context" } },
    "flows": { "type": "array", "items": { "$ref": "#/$defs/flow" } },
    "invariants": { "type": "array", "items": { "$ref": "#/$defs/invariant" } },
    "glossary": { "type": "array", "items": { "$ref": "#/$defs/term" } },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "open_questions": { "type": "array", "items": { "$ref": "#/$defs/open_question" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "texts": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "level": { "enum": ["big-picture", "process", "design"] },
    "status": {
      "enum": ["propuesto", "confirmado", "disputado", "hipótesis-sin-autor"]
    },
    "id_speaker": { "type": "string", "pattern": "^sp-[a-z0-9][a-z0-9-]*$" },
    "id_event": { "type": "string", "pattern": "^ev-[a-z0-9][a-z0-9-]*$" },
    "id_command": { "type": "string", "pattern": "^cmd-[a-z0-9][a-z0-9-]*$" },
    "id_actor": { "type": "string", "pattern": "^act-[a-z0-9][a-z0-9-]*$" },
    "id_policy": { "type": "string", "pattern": "^pol-[a-z0-9][a-z0-9-]*$" },
    "id_read_model": { "type": "string", "pattern": "^rm-[a-z0-9][a-z0-9-]*$" },
    "id_external_system": { "type": "string", "pattern": "^ext-[a-z0-9][a-z0-9-]*$" },
    "id_aggregate": { "type": "string", "pattern": "^agg-[a-z0-9][a-z0-9-]*$" },
    "id_hotspot": { "type": "string", "pattern": "^hs-[a-z0-9][a-z0-9-]*$" },
    "id_opportunity": { "type": "string", "pattern": "^op-[a-z0-9][a-z0-9-]*$" },
    "id_bounded_context": { "type": "string", "pattern": "^bc-[a-z0-9][a-z0-9-]*$" },
    "id_flow": { "type": "string", "pattern": "^fl-[a-z0-9][a-z0-9-]*$" },
    "id_term": { "type": "string", "pattern": "^gl-[a-z0-9][a-z0-9-]*$" },
    "id_invariant": { "type": "string", "pattern": "^inv-[a-z0-9][a-z0-9-]*$" },
    "id_decision": { "type": "string", "pattern": "^dec-[a-z0-9][a-z0-9-]*$" },
    "id_open_question": { "type": "string", "pattern": "^oq-[a-z0-9][a-z0-9-]*$" },
    "id_any": {
      "type": "string",
      "pattern": "^(ev|cmd|act|pol|rm|ext|agg|hs|op|bc|fl|gl|inv|dec|oq|sp)-[a-z0-9][a-z0-9-]*$"
    },
    "id_sticky": { "type": "string", "pattern": "^(ev|cmd|act|pol|rm|ext|agg|hs|op)-[a-z0-9][a-z0-9-]*$" },
    "unknown": {
      "description": "\"No sé\" is a valid answer: the field points to an open hotspot that holds the question. One hotspot may hold several unknowns of the same theme. verify.py checks the hotspot exists and is open; the level closes only if that hotspot is no-bloqueante.",
      "type": "object",
      "required": ["desconocido"],
      "additionalProperties": false,
      "properties": { "desconocido": { "$ref": "#/$defs/id_hotspot" } }
    },
    "said": {
      "description": "Something a voice said, in its own words, with who said it.",
      "type": "object",
      "required": ["words", "speaker"],
      "additionalProperties": false,
      "properties": { "words": { "$ref": "#/$defs/text" }, "speaker": { "$ref": "#/$defs/id_speaker" } }
    },
    "trigger": {
      "description": "What makes an event happen: a command or external system id, a time, or {desconocido: hs-id}. verify.py accepts only cmd- and ext- ids here: a policy never triggers an event, it issues a command that does.",
      "if": { "type": "string" },
      "then": { "$ref": "#/$defs/id_any" },
      "else": {
        "type": "object",
        "if": { "required": ["desconocido"] },
        "then": { "$ref": "#/$defs/unknown" },
        "else": {
          "type": "object",
          "required": ["time"],
          "additionalProperties": false,
          "properties": {
            "time": { "description": "When it happens, in the stakeholder's words", "$ref": "#/$defs/text" }
          }
        }
      }
    },
    "failure_path": {
      "description": "One way a command goes wrong: the id of the event that records it, an explicit 'does not apply' in the stakeholder's words, or {desconocido: hs-id}.",
      "if": { "type": "string" },
      "then": { "$ref": "#/$defs/id_event" },
      "else": {
        "type": "object",
        "if": { "required": ["desconocido"] },
        "then": { "$ref": "#/$defs/unknown" },
        "else": {
          "type": "object",
          "required": ["no_aplica", "words", "speaker"],
          "additionalProperties": false,
          "properties": {
            "no_aplica": { "const": true },
            "words": { "$ref": "#/$defs/text" },
            "speaker": { "$ref": "#/$defs/id_speaker" }
          }
        }
      }
    },
    "provenance": {
      "description": "Where the element came from. pregunta/respuesta: the question asked and the speaker's own words. fuente: existing material, which only ever yields hipótesis-sin-autor.",
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["pregunta", "respuesta", "fuente"] },
        "question": { "$ref": "#/$defs/text" },
        "answer": { "$ref": "#/$defs/text" },
        "source": { "$ref": "#/$defs/text" },
        "note": { "$ref": "#/$defs/text" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "fuente" } }, "required": ["kind"] },
          "then": { "required": ["source"] },
          "else": { "required": ["question"] }
        },
        {
          "if": { "properties": { "kind": { "const": "respuesta" } }, "required": ["kind"] },
          "then": { "required": ["answer"] }
        }
      ]
    },
    "authorship": {
      "description": "hipótesis-sin-autor has no speaker and always comes from registered material (provenance kind fuente): the AI originates nothing. Every other status needs a speaker. Adopting a hypothesis = setting a speaker and a new status.",
      "if": { "properties": { "status": { "const": "hipótesis-sin-autor" } }, "required": ["status"] },
      "then": {
        "not": { "required": ["speaker"] },
        "properties": { "provenance": { "properties": { "kind": { "const": "fuente" } } } }
      },
      "else": { "required": ["speaker"] }
    },
    "domain": {
      "type": "object",
      "required": ["name", "slug", "scope"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "language": { "$ref": "#/$defs/text" },
        "scope": {
          "type": "object",
          "required": ["includes", "excludes"],
          "additionalProperties": false,
          "properties": {
            "includes": { "$ref": "#/$defs/texts" },
            "excludes": { "type": "array", "items": { "$ref": "#/$defs/exclusion" } }
          }
        },
        "sources": {
          "description": "Existing material registered as a source of questions, never of answers.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "kind"],
            "additionalProperties": false,
            "properties": {
              "path": { "$ref": "#/$defs/text" },
              "kind": {
                "enum": ["transcripción", "documento", "código-legado", "otro"]
              },
              "note": { "$ref": "#/$defs/text" }
            }
          }
        }
      }
    },
    "exclusion": {
      "type": "object",
      "required": ["what", "why", "speaker"],
      "additionalProperties": false,
      "properties": {
        "what": { "$ref": "#/$defs/text" },
        "why": { "$ref": "#/$defs/text" },
        "speaker": { "$ref": "#/$defs/id_speaker" }
      }
    },
    "speaker": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id_speaker" },
        "name": { "$ref": "#/$defs/text" },
        "role": { "$ref": "#/$defs/text" },
        "default": { "type": "boolean" }
      }
    },
    "level_state": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": { "state": { "enum": ["pendiente", "abierto", "cerrado"] }, "closed_on": { "$ref": "#/$defs/date" } },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "cerrado" } }, "required": ["state"] },
          "then": { "required": ["closed_on"] }
        }
      ]
    },
    "pending_question": {
      "type": "object",
      "required": ["text", "kind"],
      "additionalProperties": false,
      "properties": {
        "text": { "$ref": "#/$defs/text" },
        "kind": {
          "enum": [
            "caso-límite",
            "invariante",
            "metáfora",
            "repregunta",
            "secuencia",
            "disparador",
            "exclusión",
            "frontera",
            "voces",
            "alcance",
            "lectura",
            "nombre",
            "nombre-flujo",
            "alternativas",
            "code_name"
          ]
        },
        "about": { "$ref": "#/$defs/id_any" },
        "to_speaker": { "$ref": "#/$defs/id_speaker" }
      }
    },
    "session": {
      "description": "Re-hydration block. Every storm-* skill reads it first and writes it last.",
      "type": "object",
      "required": ["current_level", "levels", "updated"],
      "additionalProperties": false,
      "properties": {
        "current_level": { "$ref": "#/$defs/level" },
        "levels": {
          "type": "object",
          "required": ["big-picture", "process", "design"],
          "additionalProperties": false,
          "properties": {
            "big-picture": { "$ref": "#/$defs/level_state" },
            "process": { "$ref": "#/$defs/level_state" },
            "design": { "$ref": "#/$defs/level_state" }
          }
        },
        "stage": {
          "description": "Where the current level stands, in the level skill's own stage names (e.g. big-picture: exploración, línea, participantes, recorrido).",
          "$ref": "#/$defs/text"
        },
        "pending_questions": {
          "description": "One slot per owner, so one level never overwrites another's question. start = storm-start's own questions (alcance, voces, exclusión).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": { "$ref": "#/$defs/pending_question" },
            "big-picture": { "$ref": "#/$defs/pending_question" },
            "process": { "$ref": "#/$defs/pending_question" },
            "design": { "$ref": "#/$defs/pending_question" }
          }
        },
        "next_step": { "$ref": "#/$defs/text" },
        "memory_pointer": { "$ref": "#/$defs/text" },
        "updated": { "$ref": "#/$defs/date" }
      }
    },
    "event": {
      "type": "object",
      "required": ["id", "name", "status", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id_event" },
        "name": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/status" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "speaker": { "$ref": "#/$defs/id_speaker" },
        "terms": { "$ref": "#/$defs/texts" },
        "pivotal": { "description": "An evento pivote: after it, everything that follows changes.", "type": "boolean" },
        "failure": {
          "description": "The voice described this event as something going wrong. It waits for the recorrido etapa, where it lands in a falla flow.",
          "type": "boolean"
        },
        "failure_mode": {
          "description": "Only when the voice knows this failure event but not which way it fails (rechazo, error or demora). A known way lives in the command's failure_paths, never here.",
          "$ref": "#/$defs/unknown"
        },
        "triggered_by": { "type": "array", "items": { "$ref": "#/$defs/trigger" } },
        "notes": { "$ref": "#/$defs/text" }
      },
      "allOf": [{ "$ref": "#/$defs/authorship" }]
    },
    "command": {
      "type": "object",
      "required": ["id", "name", "status", "provenance", "actor", "results_in"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id_command" },
        "name": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/status" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "speaker": { "$ref": "#/$defs/id_speaker" },
        "terms": { "$ref": "#/$defs/texts" },
        "actor": { "if": { "type": "string" }, "then": { "$ref": "#/$defs/id_actor" }, "else": { "$ref": "#/$defs/unknown" } },
        "results_in": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id_event" } },
        "informed_by": {
          "description": "Only for a \"no sé\" to the read-model question. A known read model lives in read_models[].informs, never here.",
          "$ref": "#/$defs/unknown"
        },
        "failure_paths": {
          "description": "Camino de falla per way a command goes wrong. storm-process resolves all three before the level closes.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rechazo": { "$ref": "#/$defs/failure_path" },
            "error": { "$ref": "#/$defs/failure_path" },
            "demora": { "$ref": "#/$defs/failure_path" }
          }
        },
        "notes": { "$ref": "#/$defs/text" }
      },
      "allOf": [{ "$ref": "#/$defs/authorship" }]
    },
    "actor": {
      "type": "object",
      "required": ["id", "name", "kind", "status", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id_actor" },
        "name": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["persona", "sistema", "externo"] },
        "status": { "$ref": "#/$defs/status" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "speaker": { "$ref": "#/$defs/id_speaker" },
        "terms": { "$ref": "#/$defs/texts" },
        "notes": { "$ref": "#/$defs/text" }
      },
      "allOf": [{ "$ref": "#/$defs/authorship" }]
    },
    "policy": {
      "description": "Cada vez que <when>, entonces <then>.",
      "type": "object",
      "required": ["id", "name", "status", "provenance", "when", "then"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id_policy" },
        "name": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/status" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "speaker": { "$ref": "#/$defs/id_speaker" },
        "terms": { "$ref": "#/$defs/texts" },
        "when": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id_event" } },
        "then": {
          "if": { "type": "string" },
          "then": { "$ref": "#/$defs/id_command" },
          "else": { "$ref": "#/$defs/unknown" }
        },
        "mode": {
          "description": "automática: the system does it on its own. manual: a person decides; that person is the actor of the then command.",
          "if": { "type": "string" },
          "then": { "enum": ["automática", "manual"] },
          "else": { "$ref": "#/$defs/unknown" }
        },
        "delay": {
          "description": "How long after the when event the then command happens, in the voice's words (\"al día siguiente\"). Optional.",
          "$ref": "#/$defs/said"
        },
        "notes": { "$ref": "#/$defs/text" }
      },
      "allOf": [{ "$ref": "#/$defs/authorship" }]
    },
    "read_model": {
      "type": "object",
      "required": ["id", "name", "status", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id_read_model" },
        "name": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/status" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "speaker": { "$ref": "#/$defs/id_speaker" },
        "terms": { "$ref": "#/$defs/texts" },
        "built_from": { "type": "array", "items": { "$ref": "#/$defs/id_event" } },
        "informs": { "type": "array", "items": { "$ref": "#/$defs/id_command" } },
        "notes": { "$ref": "#/$defs/text" }
      },
      "allOf": [{ "$ref": "#/$defs/authorship" }]
    },
    "external_system": {
      "type": "object",
      "required": ["id", "name", "status", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id_external_system" },
        "name": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/status" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "speaker": { "$ref": "#/$defs/id_speaker" },
        "terms": { "$ref": "#/$defs/texts" },
        "notes": { "$ref": "#/$defs/text" }
      },
      "allOf": [{ "$ref": "#/$defs/authorship" }]
    },
    "aggregate": {
      "type": "object",
      "required": ["id", "name", "status", "provenance", "bounded_context"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id_aggregate" },
        "name": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/status" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "speaker": { "$ref": "#/$defs/id_speaker" },
        "terms": { "$ref": "#/$defs/texts" },
        "invariants": { "type": "array", "items": { "$ref": "#/$defs/id_invariant" } },
        "handles": { "type": "array", "items": { "$ref": "#/$defs/id_command" } },
        "emits": { "type": "array", "items": { "$ref": "#/$defs/id_event" } },
        "bounded_context": {
          "description": "The area it belongs to, or {desconocido: hs-id} pointing to the open frontera-candidata that has not decided it yet.",
          "if": { "type": "string" },
          "then": { "$ref": "#/$defs/id_bounded_context" },
          "else": { "$ref": "#/$defs/unknown" }
        },
        "notes": { "$ref": "#/$defs/text" }
      },
      "allOf": [{ "$ref": "#/$defs/authorship" }]
    },
    "hotspot": {
      "type": "object",
      "required": ["id", "question", "type", "severity", "level", "resolution", "status", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id_hotspot" },
        "question": { "$ref": "#/$defs/text" },
        "type": {
          "enum": [
            "ambigüedad",
            "sinónimo",
            "conflicto-entre-voces",
            "frontera-candidata",
            "invariante-faltante",
            "metáfora-en-disputa",
            "complejidad-sin-autor",
            "deuda-semántica",
            "desconocido",
            "otro"
          ]
        },
        "severity": {
          "description": "Set by rule, never by asking: see socratic-protocol.md \"Severity\". verify.py enforces it (hotspot-rules).",
          "enum": ["bloqueante", "no-bloqueante"]
        },
        "raised_by": {
          "description": "The voice that raised a hotspot to bloqueante when no rule makes it so.",
          "$ref": "#/$defs/id_speaker"
        },
        "level": {
          "description": "The level in course when it was opened (session.current_level); a frontera-candidata is always design. See socratic-protocol.md \"Hotspot level\".",
          "$ref": "#/$defs/level"
        },
        "refs": { "type": "array", "items": { "$ref": "#/$defs/id_any" } },
        "positions": {
          "description": "One entry per voice, in its own words. Required for conflicto-entre-voces; no position wins by being recorded.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["speaker", "says"],
            "additionalProperties": false,
            "properties": { "speaker": { "$ref": "#/$defs/id_speaker" }, "says": { "$ref": "#/$defs/text" } }
          }
        },
        "resolution": { "enum": ["abierto", "resuelto"] },
        "resolved_by": { "$ref": "#/$defs/id_decision" },
        "status": { "$ref": "#/$defs/status" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "speaker": { "$ref": "#/$defs/id_speaker" },
        "notes": { "$ref": "#/$defs/text" }
      },
      "allOf": [
        { "$ref": "#/$defs/authorship" },
        {
          "if": { "properties": { "resolution": { "const": "resuelto" } }, "required": ["resolution"] },
          "then": { "required": ["resolved_by"] }
        },
        {
          "if": { "properties": { "type": { "const": "conflicto-entre-voces" } }, "required": ["type"] },
          "then": { "required": ["positions"], "properties": { "positions": { "minItems": 2 } } }
        }
      ]
    },
    "opportunity": {
      "type": "object",
      "required": ["id", "name", "status", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id_opportunity" },
        "name": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/status" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "speaker": { "$ref": "#/$defs/id_speaker" },
        "terms": { "$ref": "#/$defs/texts" },
        "refs": { "type": "array", "items": { "$ref": "#/$defs/id_any" } },
        "notes": { "$ref": "#/$defs/text" }
      },
      "allOf": [{ "$ref": "#/$defs/authorship" }]
    },
    "bounded_context": {
      "type": "object",
      "required": ["id", "name", "status", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id_bounded_context" },
        "name": { "$ref": "#/$defs/text" },
        "purpose": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/status" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "speaker": { "$ref": "#/$defs/id_speaker" },
        "notes": { "$ref": "#/$defs/text" }
      },
      "allOf": [{ "$ref": "#/$defs/authorship" }]
    },
    "flow": {
      "description": "An ordered sequence read left to right as a timeline.",
      "type": "object",
      "required": ["id", "name", "kind", "steps", "status", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id_flow" },
        "name": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["principal", "falla"] },
        "failure_of": {
          "description": "The principal flow this camino de falla belongs to. Required when kind is falla (verify.py enforces it at the big-picture gate).",
          "$ref": "#/$defs/id_flow"
        },
        "lane": { "description": "Swimlane: the area or voice whose story this is.", "$ref": "#/$defs/text" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id_sticky" } },
        "walked": {
          "description": "Whether the flow was walked at each level. A missing key means not walked.",
          "type": "object",
          "additionalProperties": false,
          "properties": { "big-picture": { "type": "boolean" }, "process": { "type": "boolean" } }
        },
        "none_said": {
          "description": "Big Picture: the voice said this flow has no pivot, or no camino de falla. Its words, not just walked.",
          "type": "object",
          "additionalProperties": false,
          "properties": { "pivot": { "$ref": "#/$defs/said" }, "failure": { "$ref": "#/$defs/said" } }
        },
        "status": { "$ref": "#/$defs/status" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "speaker": { "$ref": "#/$defs/id_speaker" },
        "notes": { "$ref": "#/$defs/text" }
      },
      "allOf": [{ "$ref": "#/$defs/authorship" }]
    },
    "term": {
      "description": "A term as the stakeholder says it, defined by cases rather than by a definition. A decision is required only when someone chose between meanings (a frontera, a conflict, a code_name); a plain yes confirms the term.",
      "type": "object",
      "required": ["id", "term", "context", "status", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id_term" },
        "term": { "$ref": "#/$defs/text" },
        "context": { "$ref": "#/$defs/text" },
        "bounded_context": { "$ref": "#/$defs/id_bounded_context" },
        "in_their_words": { "$ref": "#/$defs/text" },
        "invariants": { "type": "array", "items": { "$ref": "#/$defs/id_invariant" } },
        "validations": {
          "description": "Contingent truths about input (a format, a mandatory field). Breaking one makes the data wrong, not the concept different. Never an invariant.",
          "type": "array",
          "items": { "$ref": "#/$defs/said" }
        },
        "edge_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["case", "verdict", "speaker"],
            "additionalProperties": false,
            "properties": {
              "case": { "$ref": "#/$defs/text" },
              "verdict": { "enum": ["es", "no-es", "depende"] },
              "why": { "$ref": "#/$defs/text" },
              "speaker": { "$ref": "#/$defs/id_speaker" }
            }
          }
        },
        "metaphor": {
          "type": "object",
          "required": ["kind", "text"],
          "additionalProperties": false,
          "properties": { "kind": { "enum": ["historial", "foto", "otra"] }, "text": { "$ref": "#/$defs/text" } }
        },
        "exclusions": { "type": "array", "items": { "$ref": "#/$defs/exclusion" } },
        "decision": { "$ref": "#/$defs/id_decision" },
        "code_name": {
          "type": "object",
          "required": ["value", "decision"],
          "additionalProperties": false,
          "properties": { "value": { "$ref": "#/$defs/text" }, "decision": { "$ref": "#/$defs/id_decision" } }
        },
        "status": { "$ref": "#/$defs/status" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "speaker": { "$ref": "#/$defs/id_speaker" },
        "notes": { "$ref": "#/$defs/text" }
      },
      "allOf": [{ "$ref": "#/$defs/authorship" }]
    },
    "invariant": {
      "description": "An invariante definitorio: a rule whose violation makes the thing stop being what it is. Single home of the rule; glossary terms and aggregates reference it by id.",
      "type": "object",
      "required": ["id", "statement", "status", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id_invariant" },
        "statement": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/status" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "speaker": { "$ref": "#/$defs/id_speaker" },
        "notes": { "$ref": "#/$defs/text" }
      },
      "allOf": [{ "$ref": "#/$defs/authorship" }]
    },
    "decision": {
      "description": "An authored decision. speakers ARE the authors.",
      "type": "object",
      "required": ["id", "statement", "speakers", "why", "level", "status", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id_decision" },
        "statement": { "$ref": "#/$defs/text" },
        "speakers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id_speaker" } },
        "why": { "$ref": "#/$defs/text" },
        "alternatives_rejected": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["option", "why_not"],
            "additionalProperties": false,
            "properties": { "option": { "$ref": "#/$defs/text" }, "why_not": { "$ref": "#/$defs/text" } }
          },
          "description": "The options discarded. A decision carries this list or alternatives_asked (verify.py: decisions)."
        },
        "alternatives_asked": {
          "description": "The record that alternatives were asked for and none came up.",
          "$ref": "#/$defs/said"
        },
        "outcome": {
          "description": "Required on the decision that resolves a frontera-candidata: the senses were unified into one term, or kept separate. A unification needs one verdict per separating case (verify.py: unified-verdicts).",
          "enum": ["unificar", "separar"]
        },
        "refs": { "type": "array", "items": { "$ref": "#/$defs/id_any" } },
        "supersedes": {
          "description": "The earlier decision this one replaces. A superseded decision no longer counts (e.g. for the flujo elegido).",
          "$ref": "#/$defs/id_decision"
        },
        "level": { "$ref": "#/$defs/level" },
        "status": { "enum": ["confirmado"] },
        "provenance": { "$ref": "#/$defs/provenance" },
        "decided_on": { "$ref": "#/$defs/date" },
        "notes": { "$ref": "#/$defs/text" }
      }
    },
    "open_question": {
      "type": "object",
      "required": ["id", "question", "level"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id_open_question" },
        "question": { "$ref": "#/$defs/text" },
        "level": { "$ref": "#/$defs/level" },
        "target": {
          "description": "Who takes the question when it is not for a voice, e.g. praxis-design for a deriva técnica.",
          "$ref": "#/$defs/text"
        },
        "to_speaker": { "$ref": "#/$defs/id_speaker" },
        "refs": { "type": "array", "items": { "$ref": "#/$defs/id_any" } },
        "notes": { "$ref": "#/$defs/text" }
      }
    }
  }
}
